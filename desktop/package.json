{
  "name": "glint",
  "productName": "Glint",
  "version": "1.3.0",
  "description": "Glint - game clips for Nookara",
  "license": "AGPL-3.0-only",
  "author": "Ikelene",
  "main": "main.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prepare-native": "node scripts/sync-games.js && node scripts/build-helper.js && node scripts/fetch-ffmpeg.js",
    "prestart": "npm run prepare-native",
    "start": "electron .",
    "dev": "npm start",
    "check": "node scripts/check.js",
    "test": "node scripts/sync-games.js --check && node --test \"test/*.test.js\"",
    "sounds": "node scripts/make-sounds.js",
    "icons": "node scripts/make-icons.js",
    "prebuild": "npm run prepare-native && node scripts/sync-games.js --check && npm run check && npm test",
    "build": "electron-builder --win nsis",
    "predist": "npm run prebuild",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.ikelene.glint",
    "productName": "Glint",
    "copyright": "Ikelene / IKELENE.net",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "vendor/ffmpeg/LICENSE.txt",
        "to": "ffmpeg/LICENSE.txt"
      },
      {
        "from": "bin/glint-helper.exe",
        "to": "bin/glint-helper.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glint",
      "uninstallDisplayName": "Glint",
      "artifactName": "Glint-Setup-${version}.exe"
    }
  }
}
